<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Préstamos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="barra">
      <nav>
        <%= link_to "Préstamos", root_path, class: "marca" %>
        <%= link_to "Inicio", root_path %>
        <%= link_to "Personas", personas_path %>
        <%= link_to "Préstamos", prestamos_path %>
      </nav>
    </header>

    <main>
      <% if notice.present? %><p class="aviso"><%= notice %></p><% end %>
      <% if alert.present? %><p class="aviso error"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
