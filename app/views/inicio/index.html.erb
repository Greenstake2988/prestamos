<h1>Inicio</h1>

<div class="tarjetas">
  <div class="tarjeta">
    <div class="etiqueta">Prestado</div>
    <div class="valor"><%= number_to_currency(@total_prestado) %></div>
  </div>
  <div class="tarjeta">
    <div class="etiqueta">Total a devolver</div>
    <div class="valor"><%= number_to_currency(@total_a_devolver) %></div>
  </div>
  <div class="tarjeta">
    <div class="etiqueta">Ganancia</div>
    <div class="valor"><%= number_to_currency(@ganancia) %></div>
  </div>
  <div class="tarjeta destacada">
    <div class="etiqueta">Falta por cobrar (estimado)</div>
    <div class="valor"><%= number_to_currency(@pendiente) %></div>
  </div>
</div>

<h2>Próximos pagos (14 días)</h2>

<% if @proximos_pagos.any? %>
  <table>
    <thead>
      <tr><th>Fecha</th><th>Persona</th><th>Monto</th></tr>
    </thead>
    <tbody>
      <% @proximos_pagos.each do |pago| %>
        <tr>
          <td><%= l pago[:fecha], format: :long %></td>
          <td><%= link_to pago[:persona].nombre, pago[:prestamo] %></td>
          <td><%= number_to_currency(pago[:monto]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No hay pagos en los próximos 14 días.</p>
<% end %>
