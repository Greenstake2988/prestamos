<% content_for :title, "Préstamos" %>

<div class="encabezado">
  <h1>Préstamos</h1>
  <div class="acciones">
    <%= link_to "Nuevo préstamo", new_prestamo_path, class: "boton" %>
    <%= link_to "Exportar a Excel", exportar_prestamos_path %>
  </div>
</div>

<div id="prestamos">
  <% @prestamos.each do |prestamo| %>
    <%= render prestamo %>
    <p><%= link_to "Ver este préstamo", prestamo %></p>
  <% end %>
</div>
