<p style="color: green"><%= notice %></p>

<%= render @prestamo %>

<div>
  <%= link_to "Edit this prestamo", edit_prestamo_path(@prestamo) %> |
  <%= link_to "Back to prestamos", prestamos_path %>

  <%= button_to "Destroy this prestamo", @prestamo, method: :delete %>
</div>

<h2>Calendario de pagos</h2>
<table>
  <thead>
    <tr><th>#</th><th>Fecha</th><th>Monto</th></tr>
  </thead>
  <tbody>
    <% @prestamo.calendario.each do |pago| %>
      <tr>
        <td><%= pago[:numero] %></td>
        <td><%= l pago[:fecha], format: :long %></td>
        <td><%= number_to_currency(pago[:monto]) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
