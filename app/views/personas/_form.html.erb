<%= form_with(model: persona) do |form| %>
  <% if persona.errors.any? %>
    <div style="color: red">
        <h2><%= persona.errors.count == 1 ? "1 error impidió" : "#{persona.errors.count} errores impidieron" %> guardar esta persona:</h2>
      <ul>
        <% persona.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :nombre, style: "display: block" %>
    <%= form.text_field :nombre %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
